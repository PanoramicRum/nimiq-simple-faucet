{
  "name": "@faucet/abuse-geoip",
  "version": "0.0.1",
  "private": true,
  "description": "Geo-IP / ASN / VPN / datacenter abuse check with pluggable resolvers (MaxMind GeoLite2 and IPinfo).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@faucet/core": "workspace:*",
    "@ip-location-db/dbip-asn-mmdb": "^2.3.2026060407",
    "@ip-location-db/dbip-country-mmdb": "^2.3.2026060120",
    "maxmind": "^5.0.7",
    "undici": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
