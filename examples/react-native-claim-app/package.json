    "build": "tsc --noEmit",
    "build:web": "expo export -p web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.11",
    "@nimiq-faucet/react-native": "workspace:*",
    "expo": "~55.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-native": "0.85.3",
    "react-native-device-info": "^15.0.2",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "typescript": "^6.0.3"
  }
}
