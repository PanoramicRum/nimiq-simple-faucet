# Copy to `.env`. Expo exposes EXPO_PUBLIC_* env vars to the app at build/run time.
#
# The faucet URL the app hits. Must be reachable from the device/emulator and
# CORS-allowed by the faucet (its FAUCET_CORS_ORIGINS). On an Android emulator
# use http://10.0.2.2:8080; on a physical device use your machine's LAN IP.
EXPO_PUBLIC_FAUCET_URL=http://localhost:8080

# Unsigned identifier sent in hostContext.uid. In production a backend signs
# the hostContext; the demo passes a plain uid. See docs/abuse-layers/integration-guide.md.
EXPO_PUBLIC_INTEGRATOR_ID=react-native-example
