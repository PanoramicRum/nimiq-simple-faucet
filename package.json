{
  "name": "nimiq-simple-faucet",
  "version": "0.0.1",
  "private": true,
  "description": "Reusable self-hosted Nimiq faucet / payout service with strong abuse prevention and first-class AI-agent integration",
  "license": "MIT",
  "author": "Nimiq <richy@nimiq.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/PanoramicRum/nimiq-simple-faucet.git"
  },
  "homepage": "https://github.com/PanoramicRum/nimiq-simple-faucet#readme",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test --filter=!@nimiq-faucet/e2e",
    "test:e2e": "pnpm --filter @nimiq-faucet/e2e test",
    "test:e2e:install": "cd tests/e2e && npx playwright install --with-deps",
    "pre-merge": "turbo run typecheck build test --filter=!@nimiq-faucet/e2e && pnpm config-reference:check",
    "presmoke:testnet": "pnpm build",
    "smoke:testnet": "tsx scripts/smoke-testnet.mts",
    "generate:wallet": "tsx scripts/generate-wallet.mts",
    "generate:config-reference": "tsx scripts/generate-config-reference.mts",
    "config-reference:check": "tsx scripts/generate-config-reference.mts --check",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@faucet/abuse-hashcash": "workspace:*",
    "@nimiq/core": "^2.5.1",
    "@types/node": "^26.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "turbo": "^2.10.6",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "nimiq",
    "faucet",
    "payout",
    "crypto-faucet",
    "mcp-server",
    "abuse-prevention",
    "blockchain"
  ]
}
